# Motor seçimi: mock (anahtar gerekmez) veya mirofish
SIM_ENGINE=mock

# --- SIM_ENGINE=mirofish için ---
# MiroFish backend'i ayrı çalışır (repo kökünde `npm run backend`, port 5001).
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL_NAME ve ZEP_API_KEY'i MiroFish'in
# KENDİ kökündeki .env dosyasına yaz; bu serviste tutulmaz.
MIROFISH_URL=http://localhost:5001
MIROFISH_MAX_ROUNDS=3
MIROFISH_STATE_FILE=.mirofish_world.json

# Görsel + metin füzyonu için OpenAI uyumlu vision modeli (boşsa metin tabanlı mock füzyon)
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# Marka profili ve öneriler için metin LLM'i (MiroFish'in LLM_* ayarıyla aynı; repo kökündeki .env'den de okunur)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:7b-instruct
