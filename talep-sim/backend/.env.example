# Motor seçimi: mock (anahtar gerekmez), panel (MiroFish'siz, önerilen) veya mirofish
SIM_ENGINE=mock

# --- SIM_ENGINE=panel için (bkz. docs/panel-motoru.md) ---
# LLM_* ayarlarındaki modeli kullanır; Zep ve MiroFish gerekmez.
# PANEL_DATA_DIR=            # müşterinin persona/bağlam klasörü; boşsa backend/panel_data
PANEL_SIZE=12               # bölge başına kişi
PANEL_CONCURRENCY=2         # aynı anda LLM çağrısı (Ollama'da OLLAMA_NUM_PARALLEL ile eşleştir)
PANEL_MIN_VALID=4
PANEL_GUIDED=json_schema    # json_schema | json_object | none (desteklenmezse otomatik alta iner)
PANEL_TEMPERATURE=0.7
PANEL_TIMEOUT=180
PANEL_REPAIR_RETRIES=1
PANEL_PEER_ROUND=false      # akran turu: çağrı sayısını ikiye katlar
# PANEL_LLM_BASE_URL=       # panel için ayrı model/sunucu (boşsa LLM_BASE_URL)
# PANEL_LLM_MODEL=

# --- SIM_ENGINE=mirofish için ---
# MiroFish backend'i ayrı çalışır (repo kökünde `npm run backend`, port 5001).
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL_NAME ve ZEP_API_KEY'i MiroFish'in
# KENDİ kökündeki .env dosyasına yaz; bu serviste tutulmaz.
MIROFISH_URL=http://localhost:5001
MIROFISH_MAX_ROUNDS=3
MIROFISH_STATE_FILE=.mirofish_world.json
# Yavaş yerel model (Qwen/Ollama) için: bölgeler sırayla, ajanlar küçük gruplarla röportaj edilir
# Dünya kurma (ontoloji/grafik/profil) için okuma zaman aşımı, saniye; yerel modelde ilk kurulum 10-30 dk sürebilir
MIROFISH_BUILD_TIMEOUT=3600
MIROFISH_BATCH_SIZE=3
MIROFISH_CONCURRENCY=1
MIROFISH_INTERVIEW_TIMEOUT=180
MIROFISH_TIMEOUT_RETRIES=1
MIROFISH_MIN_VALID=2
# Bölge başına röportaj edilecek ajan sayısı (seed'de bölge başına 10 tüketici var)
MIROFISH_AGENTS_PER_REGION=10

# Görsel + metin füzyonu için OpenAI uyumlu vision modeli (boşsa metin tabanlı mock füzyon)
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus

# Marka profili ve öneriler için metin LLM'i (MiroFish'in LLM_* ayarıyla aynı; repo kökündeki .env'den de okunur)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:7b-instruct
